POSTGRES_USER=hr
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hr_payroll
POSTGRES_PORT=5432
DATABASE_URL=postgresql://hr:change-me@localhost:5432/hr_payroll?schema=public

API_PORT=3000
UPLOADS_DIR=uploads
SWAGGER_ENABLED=true

# Signs access tokens (HS256). Required, at least 32 characters.
# generate: openssl rand -base64 48
JWT_ACCESS_SECRET=

# Origin allowed by CORS (the web dev server)
WEB_ORIGIN=http://localhost:5173

# Local date used for "hire date can't be in the future"
TZ=Africa/Cairo
