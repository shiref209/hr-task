generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum EmployeeType {
  HR
  EMPLOYEE
}

model Department {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @unique
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  employees Employee[]

  @@map("departments")
}

model Employee {
  id              String            @id @default(uuid()) @db.Uuid
  fullName        String            @map("full_name") @db.VarChar(100)
  // Lowercased by the shared Zod schema, so a plain unique index is case-insensitive.
  // Unique forever, soft-deleted rows included.
  email           String            @unique @db.VarChar(254)
  phone           String?           @db.VarChar(16)
  jobTitle        String            @map("job_title") @db.VarChar(100)
  departmentId    String            @map("department_id") @db.Uuid
  department      Department        @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  hireDate        DateTime          @map("hire_date") @db.Date
  baseSalary      Decimal           @map("base_salary") @db.Decimal(12, 2)
  status          EmployeeStatus    @default(ACTIVE)
  type            EmployeeType      @default(EMPLOYEE)
  profileImageUrl String?           @map("profile_image_url")
  // null = use the default tax table
  taxTableId      String?           @map("tax_table_id") @db.Uuid
  taxTable        TaxTable?         @relation(fields: [taxTableId], references: [id], onDelete: Restrict)
  payItems        EmployeePayItem[]
  user            User?
  deletedAt       DateTime?         @map("deleted_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  // List: WHERE deleted_at [AND department/status/type] ORDER BY full_name, id
  @@index([deletedAt, fullName, id])
  // FK index; serves the departmentId filter
  @@index([departmentId])
  // Last-HR guard: count active, non-deleted HR
  @@index([type, status])
  // FK index; serves countAssignedEmployees
  @@index([taxTableId])
  @@map("employees")
}

enum PayItemKind {
  ALLOWANCE
  DEDUCTION
}

// Hand-written in the migration (Prisma can't express them): unique index on lower(name),
// partial unique index on is_default WHERE is_default.
model TaxTable {
  id        String       @id @default(uuid()) @db.Uuid
  name      String       @db.VarChar(60)
  isDefault Boolean      @default(false) @map("is_default")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  brackets  TaxBracket[]
  employees Employee[]

  @@map("tax_tables")
}

model TaxBracket {
  id         String   @id @default(uuid()) @db.Uuid
  taxTableId String   @map("tax_table_id") @db.Uuid
  taxTable   TaxTable @relation(fields: [taxTableId], references: [id], onDelete: Cascade)
  position   Int
  // null = no upper limit
  upTo       Decimal? @map("up_to") @db.Decimal(12, 2)
  rate       Decimal  @db.Decimal(5, 2)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // FK index + ordered load; unique also guarantees stable ordering
  @@unique([taxTableId, position])
  @@map("tax_brackets")
}

// Single row: id is always 1 (CHECK in the migration).
model SocialInsuranceSettings {
  id        Int      @id @default(1)
  rate      Decimal  @db.Decimal(5, 2)
  cap       Decimal? @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("social_insurance_settings")
}

model EmployeePayItem {
  id         String      @id @default(uuid()) @db.Uuid
  employeeId String      @map("employee_id") @db.Uuid
  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  kind       PayItemKind
  name       String      @db.VarChar(60)
  amount     Decimal     @db.Decimal(12, 2)
  position   Int
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  // FK index; serves findByEmployee ORDER BY position
  @@index([employeeId, position])
  @@map("employee_pay_items")
}

// Passwords are stored only as a scrypt hash. CHECK (password_hash LIKE 'scrypt$%') is hand-written in the migration.
// Role = linked employee's type.
model User {
  id            String         @id @default(uuid()) @db.Uuid
  // Lowercased by the app, so a plain unique index is case-insensitive.
  email         String         @unique @db.VarChar(254)
  passwordHash  String         @map("password_hash")
  employeeId    String         @unique @map("employee_id") @db.Uuid
  employee      Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@map("users")
}

// tokenHash = hex SHA-256 of the opaque token; the raw token is never stored.
model RefreshToken {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash        String    @unique @map("token_hash") @db.Char(64)
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  // Absolute session lifetime: carried over unchanged on rotation.
  sessionStartedAt DateTime  @map("session_started_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}
