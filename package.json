{
  "name": "hr-payroll",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @hr/types build && pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm --filter @hr/types build && pnpm -r lint",
    "typecheck": "pnpm --filter @hr/types build && pnpm -r typecheck",
    "test": "pnpm --filter @hr/types build && pnpm -r test"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "prisma",
      "@prisma/client",
      "@prisma/engines"
    ]
  }
}
